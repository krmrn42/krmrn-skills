{
  "name": "@krmrn42/multivac",
  "version": "0.7.0",
  "description": "Cross-project full-text search across local Claude Code conversations. Bundled-dependencies Node CLI using built-in node:sqlite (Node 22.5+). TUI picker, resume in original cwd, `multivac init` installs the companion Claude Code plugin.",
  "keywords": [
    "claude-code",
    "search",
    "fts",
    "fts5",
    "sqlite",
    "conversation",
    "history",
    "resume",
    "tui",
    "node-sqlite"
  ],
  "license": "MIT",
  "author": {
    "name": "krmrn42"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krmrn42/krmrn-skills.git",
    "directory": "packages/multivac"
  },
  "bugs": {
    "url": "https://github.com/krmrn42/krmrn-skills/issues"
  },
  "homepage": "https://github.com/krmrn42/krmrn-skills/tree/main/packages/multivac#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "multivac": "dist/multivac.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs && chmod +x dist/multivac.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/unit/**/*.test.ts' 'test/tui/**/*.test.tsx'",
    "test:sh": "bash test/multivac.test.sh",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "esbuild": "^0.23.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module"
}